@model IEnumerable<CatMS.Models.Order>

<h2>Order List</h2>

<a asp-action="Create" class="btn btn-primary mb-3">Create Order</a>

<table class="table table-bordered">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Date</th>
            <th>Buyer</th>
            <th>Cat</th>
            <th>Total</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.OrderDate.ToString("dd MMM yyyy")</td>
                <td>@item.Buyer?.UserName</td>
                <td>@item.Cat?.Name</td>
                <td>৳ @item.TotalAmount</td>
                <td>
                    <a asp-action="Details"
                       asp-route-id="@item.Id"
                       class="btn btn-info btn-sm">
                        Details
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
