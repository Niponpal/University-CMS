@model CatMS.Models.Order

@{
    ViewData["Title"] = "Order Details";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <h1 class="display-6 fw-semibold text-dark">Order Details</h1>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-2"></i>Back to List
        </a>
    </div>

    <div class="row">
        <!-- Left Column: Order & Buyer Info -->
        <div class="col-lg-8">
            <!-- Order Summary Card -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-bottom py-3">
                    <div class="d-flex align-items-center">
                        <div class="bg-primary bg-opacity-10 p-2 rounded me-3">
                            <i class="fas fa-receipt text-primary"></i>
                        </div>
                        <h5 class="mb-0 fw-semibold">Order Summary</h5>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-muted small mb-1">ORDER ID</label>
                            <p class="fw-semibold mb-0">#@Model.Id</p>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-muted small mb-1">ORDER DATE</label>
                            <p class="fw-semibold mb-0">@Model.OrderDate.ToString("dd MMMM yyyy")</p>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-muted small mb-1">STATUS</label>
                            <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill">
                                <i class="fas fa-check-circle me-1"></i>Completed
                            </span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-muted small mb-1">TOTAL AMOUNT</label>
                            <h4 class="text-primary fw-bold mb-0">৳ @Model.TotalAmount.ToString("N2")</h4>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Buyer Information Card -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-bottom py-3">
                    <div class="d-flex align-items-center">
                        <div class="bg-success bg-opacity-10 p-2 rounded me-3">
                            <i class="fas fa-user text-success"></i>
                        </div>
                        <h5 class="mb-0 fw-semibold">Customer Information</h5>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <div class="d-flex align-items-start">
                                <div class="bg-light rounded-circle p-2 me-3">
                                    <i class="fas fa-user-circle text-muted"></i>
                                </div>
                                <div>
                                    <label class="form-label text-muted small mb-1">CUSTOMER NAME</label>
                                    <p class="fw-semibold mb-0">@Model.Buyer?.UserName</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="d-flex align-items-start">
                                <div class="bg-light rounded-circle p-2 me-3">
                                    <i class="fas fa-envelope text-muted"></i>
                                </div>
                                <div>
                                    <label class="form-label text-muted small mb-1">EMAIL ADDRESS</label>
                                    <p class="fw-semibold mb-0">@Model.Email</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="d-flex align-items-start">
                                <div class="bg-light rounded-circle p-2 me-3">
                                    <i class="fas fa-phone text-muted"></i>
                                </div>
                                <div>
                                    <label class="form-label text-muted small mb-1">PHONE NUMBER</label>
                                    <p class="fw-semibold mb-0">@Model.Phone</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="d-flex align-items-start">
                                <div class="bg-light rounded-circle p-2 me-3">
                                    <i class="fas fa-map-marker-alt text-muted"></i>
                                </div>
                                <div>
                                    <label class="form-label text-muted small mb-1">DELIVERY ADDRESS</label>
                                    <p class="fw-semibold mb-0">@Model.Address</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column: Cat Information -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-bottom py-3">
                    <div class="d-flex align-items-center">
                        <div class="bg-warning bg-opacity-10 p-2 rounded me-3">
                            <i class="fas fa-cat text-warning"></i>
                        </div>
                        <h5 class="mb-0 fw-semibold">Cat Details</h5>
                    </div>
                </div>
                <div class="card-body">
                    <div class="text-center mb-4">
                        <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center"
                             style="width: 120px; height: 120px;">
                            <i class="fas fa-paw fa-3x text-warning"></i>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted small mb-1">CAT NAME</label>
                        <h6 class="fw-semibold mb-0">@Model.Cat?.Name</h6>
                    </div>

                    <div class="row">
                        <div class="col-6 mb-3">
                            <label class="form-label text-muted small mb-1">BREED</label>
                            <p class="fw-semibold mb-0">@Model.Cat?.Breed</p>
                        </div>
                        <div class="col-6 mb-3">
                            <label class="form-label text-muted small mb-1">AGE</label>
                            <p class="fw-semibold mb-0">@Model.Cat?.Age Months</p>
                        </div>
                        <div class="col-6 mb-3">
                            <label class="form-label text-muted small mb-1">GENDER</label>
                            <span class="badge @(Model.Cat?.Gender == "Male" ? "bg-info bg-opacity-10 text-info" : "bg-pink bg-opacity-10 text-pink") px-3 py-2 rounded-pill">
                                @Model.Cat?.Gender
                            </span>
                        </div>
                        <div class="col-6 mb-3">
                            <label class="form-label text-muted small mb-1">PRICE</label>
                            <p class="fw-semibold text-primary mb-0">৳ @Model.TotalAmount.ToString("N2")</p>
                        </div>
                    </div>

                    <div class="mt-4 pt-3 border-top">
                        <div class="d-grid">
                            <button class="btn btn-outline-warning">
                                <i class="fas fa-paw me-2"></i>View Cat Profile
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Action Buttons -->
    <div class="d-flex justify-content-between mt-4 pt-3 border-top">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-2"></i>Back to Orders
        </a>
        <div>
            <button class="btn btn-outline-primary me-2">
                <i class="fas fa-print me-2"></i>Print Invoice
            </button>
            <button class="btn btn-primary">
                <i class="fas fa-download me-2"></i>Download Details
            </button>
        </div>
    </div>
</div>

<!-- Add Font Awesome for icons -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>
    .bg-pink {
        background-color: #ff69b4;
    }

    .text-pink {
        color: #ff69b4;
    }

    .card {
        border-radius: 12px;
    }

    .card-header {
        border-radius: 12px 12px 0 0 !important;
    }

    .form-label {
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.5px;
    }

    .badge {
        font-weight: 500;
    }
</style>



